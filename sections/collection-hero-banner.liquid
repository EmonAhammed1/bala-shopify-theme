        {
          "value": "80vh",
          "label": "Large (80vh)"
        },
        {
          "value": "60vh",
          "label": "Medium (60vh)"
        },
        {
          "value": "40vh",
          "label": "Small (40vh)"
        },
        {
          "value": "adapt",
          "label": "Adapt to image ratio"
        },
        {
          "value": "custom",
          "label": "Custom pixels"
        }
      ],
      "default": "100vh",
      "label": "Desktop height"
    },
    {
      "type": "range",
      "id": "custom_desktop_height",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Custom desktop height",
      "default": 650
    },
    {
      "type": "select",
      "id": "mobile_height",
      "options": [
        {
          "value": "100vh",
          "label": "Full screen (100vh)"
        },
        {
          "value": "80vh",
          "label": "Large (80vh)"
        },
        {
          "value": "60vh",
          "label": "Medium (60vh)"
        },
        {
          "value": "40vh",
          "label": "Small (40vh)"
        },
        {
          "value": "adapt",
          "label": "Adapt to image ratio"
        },
        {
          "value": "custom",
          "label": "Custom pixels"
        }
      ],
      "default": "100vh",
      "label": "Mobile height"
    },
    {
      "type": "range",
      "id": "custom_mobile_height",
      "min": 250,
      "max": 800,
      "step": 10,
