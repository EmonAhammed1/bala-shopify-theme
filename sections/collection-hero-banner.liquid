      "label": "Button / Link Label",
      "default": "SHOP NOW"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "link_arrow",
          "label": "Inline text link with arrow (Reference style)"
        },
        {
          "value": "outline",
          "label": "Outlined button"
        },
        {
          "value": "solid",
          "label": "Solid button"
        },
        {
          "value": "standalone_arrow",
          "label": "Button text with arrow below"
        }
      ],
      "default": "link_arrow",
      "label": "Style"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "center",
