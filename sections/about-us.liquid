{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .about-us-wrapper-{{ section.id }} {
    color: rgb(var(--color-foreground));
    background-color: rgb(var(--color-background));
  }

  .color-scheme-{{ section.id }}.color-custom {
    --color-background: {{ section.settings.custom_colors_background.red }}, {{ section.settings.custom_colors_background.green }}, {{ section.settings.custom_colors_background.blue }};
    --gradient-background: {% if section.settings.custom_gradient_background != blank %}{{ section.settings.custom_gradient_background }}{% else %}{{ section.settings.custom_colors_background }}{% endif %};
    --color-foreground: {{ section.settings.custom_colors_text.red }}, {{ section.settings.custom_colors_text.green }}, {{ section.settings.custom_colors_text.blue }};
    --color-button: {{ section.settings.custom_colors_solid_button_background.red }}, {{ section.settings.custom_colors_solid_button_background.green }}, {{ section.settings.custom_colors_solid_button_background.blue }};
    --color-button-text: {{ section.settings.custom_colors_solid_button_text.red }}, {{ section.settings.custom_colors_solid_button_text.green }}, {{ section.settings.custom_colors_solid_button_text.blue }};
    --color-base-outline-button-labels: {{ section.settings.custom_colors_outline_button.red }}, {{ section.settings.custom_colors_outline_button.green }}, {{ section.settings.custom_colors_outline_button.blue }};
  }

  .about-us-container-{{ section.id }} {
    max-width: {{ section.settings.max_width | default: 1300 }}px;
    margin: 0 auto;
  }

  .about-us-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .about-us-grid-{{ section.id }} {
      grid-template-columns: {% if section.settings.image_position == 'right' %}1.15fr 0.85fr{% else %}0.85fr 1.15fr{% endif %};
      gap: 6rem;
    }
  }

  @media screen and (min-width: 1200px) {
    .about-us-grid-{{ section.id }} {
      gap: 7.5rem;
    }
  }

  /* Image Column Styling */
  .about-us__media-wrapper-{{ section.id }} {
    position: relative;
    width: 100%;
    {% if section.settings.image_position == 'right' %}
      order: 2;
    {% else %}
      order: 1;
    {% endif %}
  }

  @media screen and (max-width: 989px) {
    .about-us__media-wrapper-{{ section.id }} {
      order: 1;
      max-width: 540px;
      margin: 0 auto;
    }
  }

  .about-us__media-card {
    position: relative;
    border-radius: var(--media-radius, 14px);
    overflow: hidden;
    box-shadow: 0 20px 45px -15px rgba(var(--color-foreground), 0.12), 0 0 0 1px rgba(var(--color-foreground), 0.06);
    background: rgba(var(--color-foreground), 0.03);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .about-us__media-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 26px 50px -15px rgba(var(--color-foreground), 0.16), 0 0 0 1px rgba(var(--color-foreground), 0.08);
  }

  .about-us__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 3 / 4;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about-us__media-card:hover .about-us__image {
    transform: scale(1.02);
  }

  .about-us__media-badge {
    position: absolute;
    bottom: 1.6rem;
    left: 1.6rem;
    right: 1.6rem;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 1.2rem 1.6rem;
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    display: flex;
    align-items: center;
    gap: 1rem;
    color: #1F1E1D;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.04rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  }

  .about-us__media-badge svg {
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
    fill: #1F1E1D;
  }

  /* Content Column Styling */
  .about-us__content-wrapper-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
    {% if section.settings.image_position == 'right' %}
      order: 1;
    {% else %}
      order: 2;
    {% endif %}
  }

  @media screen and (max-width: 989px) {
    .about-us__content-wrapper-{{ section.id }} {
      order: 2;
      text-align: left;
    }
  }

  .about-us__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18rem;
    color: rgba(var(--color-foreground), 0.7);
  }

  .about-us__eyebrow-spark {
    display: inline-block;
    color: rgb(var(--color-foreground));
    animation: spark-pulse 3s infinite ease-in-out;
  }

  @keyframes spark-pulse {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.85; }
    50% { transform: scale(1.15) rotate(8deg); opacity: 1; }
  }

  .about-us__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    letter-spacing: calc(var(--font-heading-scale, 1) * var(--font-heading-letter-spacing, 0.8px));
    line-height: 1.2;
    color: rgb(var(--color-foreground));
    font-size: clamp(2.4rem, 4vw, 3.8rem);
  }

  .about-us__story-text {
    font-family: var(--font-body-family);
    font-size: clamp(1.5rem, 1.8vw, 1.7rem);
    line-height: 1.75;
    letter-spacing: 0.03rem;
    color: rgba(var(--color-foreground), 0.88);
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .about-us__story-text p {
    margin: 0;
  }

  /* Quote Block */
  .about-us__quote-box {
    position: relative;
    padding: 2.2rem 2.6rem;
    background: rgba(var(--color-foreground), 0.035);
    border-radius: 12px;
    border-left: 3px solid rgb(var(--color-foreground));
    margin: 0.8rem 0;
  }

  .about-us__quote-text {
    font-family: var(--font-heading-family);
    font-size: clamp(1.6rem, 2vw, 1.95rem);
    line-height: 1.5;
    font-style: italic;
    color: rgb(var(--color-foreground));
    margin: 0 0 1rem 0;
    font-weight: 500;
  }

  .about-us__quote-author {
    font-family: var(--font-body-family);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.08rem;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.65);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Values / Pillars Grid */
  .about-us__values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
  }

  @media screen and (max-width: 749px) {
    .about-us__values-grid {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
  }

  .about-us__value-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .about-us__value-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.8rem;
    height: 3.8rem;
    border-radius: 50%;
    background: rgba(var(--color-foreground), 0.05);
    color: rgb(var(--color-foreground));
    margin-bottom: 0.4rem;
  }

  .about-us__value-title {
    font-family: var(--font-heading-family);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: 0.03rem;
    color: rgb(var(--color-foreground));
    margin: 0;
  }

  .about-us__value-desc {
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    line-height: 1.5;
    color: rgba(var(--color-foreground), 0.7);
    margin: 0;
  }

  /* Actions */
  .about-us__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .about-us__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
  }
{%- endstyle -%}

<section
  id="shopify-section-{{ section.id }}"
  class="about-us-wrapper-{{ section.id }} color-scheme-{{ section.id }} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding animate-section"
>
  <div class="page-width about-us-container-{{ section.id }}">
    <div class="about-us-grid-{{ section.id }}">
      
      <!-- Media Column -->
      <div class="about-us__media-wrapper-{{ section.id }} animate-item">
        <div class="about-us__media-card">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                decoding: 'async',
                class: 'about-us__image',
                widths: '375, 550, 750, 1100, 1400',
                sizes: '(min-width: 990px) 500px, 100vw',
                alt: section.settings.heading | escape
            }}
          {%- else -%}
            <img
              src="{{ 'about-us-founder.png' | asset_url }}"
              alt="Meltem, Founder of Bálá in Bursa atelier"
              class="about-us__image"
              loading="lazy"
              decoding="async"
              width="1000"
              height="1333"
            >
          {%- endif -%}

          {%- if section.settings.image_badge != blank -%}
            <div class="about-us__media-badge">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
              </svg>
              <span>{{ section.settings.image_badge }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- Content Column -->
      <div class="about-us__content-wrapper-{{ section.id }} animate-item">
        
        {%- if section.settings.eyebrow != blank -%}
          <div class="about-us__eyebrow">
            <span class="about-us__eyebrow-spark">✦</span>
            <span>{{ section.settings.eyebrow }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="about-us__heading">
            {{ section.settings.heading }}
          </h1>
        {%- endif -%}

        <div class="about-us__story-text">
          {%- if section.settings.paragraph_1 != blank -%}
            <p>{{ section.settings.paragraph_1 }}</p>
          {%- endif -%}

          {%- if section.settings.paragraph_2 != blank -%}
            <p>{{ section.settings.paragraph_2 }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.quote_text != blank -%}
          <div class="about-us__quote-box">
            <div class="about-us__quote-text">
              “{{ section.settings.quote_text }}”
            </div>
            {%- if section.settings.quote_author != blank -%}
              <div class="about-us__quote-author">
                <span>—</span>
                <span>{{ section.settings.quote_author }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_values -%}
          <div class="about-us__values-grid">
            <div class="about-us__value-card">
              <div class="about-us__value-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              </div>
              <h3 class="about-us__value-title">{{ section.settings.value_1_title | default: 'Bursa Atelier' }}</h3>
              <p class="about-us__value-desc">{{ section.settings.value_1_desc | default: 'Crafted closely with skilled artisans in our Bursa atelier.' }}</p>
            </div>

            <div class="about-us__value-card">
              <div class="about-us__value-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </div>
              <h3 class="about-us__value-title">{{ section.settings.value_2_title | default: 'Pure Fabrics' }}</h3>
              <p class="about-us__value-desc">{{ section.settings.value_2_desc | default: 'Carefully tested organic textures, fits, and premium finishes.' }}</p>
            </div>

            <div class="about-us__value-card">
              <div class="about-us__value-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                  <line x1="9" y1="9" x2="9.01" y2="9"></line>
                  <line x1="15" y1="9" x2="15.01" y2="9"></line>
                </svg>
              </div>
              <h3 class="about-us__value-title">{{ section.settings.value_3_title | default: 'Room to Be Little' }}</h3>
              <p class="about-us__value-desc">{{ section.settings.value_3_desc | default: 'Freedom of movement for joyful, everyday childhood adventures.' }}</p>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="about-us__actions">
            <a
              href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
              class="button button--primary about-us__button"
            >
              <span>{{ section.settings.button_label }}</span>
              <svg class="icon icon-arrow" viewBox="0 0 14 10" width="14" height="10" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M1 5h12m-4-4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>

            {%- if section.settings.secondary_button_label != blank -%}
              <a
                href="{{ section.settings.secondary_button_link | default: '/pages/contact' }}"
                class="button button--secondary about-us__button"
              >
                <span>{{ section.settings.secondary_button_label }}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Us Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Media Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder Image",
      "info": "Leave blank to use default atelier photo (about-us-founder.png)"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop Image Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "image_badge",
      "label": "Image Badge / Caption",
      "default": "Bursa Atelier • Developing future collections"
    },
    {
      "type": "header",
      "content": "Story Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Subtitle",
      "default": "A Note From Our Founder"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hi, I'm Meltem, founder of Bálá."
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1 (Atelier Story)",
      "default": "Creating my own brand has been a dream of mine for years, and these days in Bursa brought that dream one step closer. They were spent sketching future collections, working closely with our atelier, and testing the fabrics, fits and finishes of the pieces we'll soon be launching."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2 (Brand Vision & Spark Symbol)",
      "default": "Bálá is deeply personal to me. From the meaning behind its name to our spark symbol, every detail carries a story. My vision is to create thoughtful, comfortable clothing that lets children move freely, be themselves and have room to be little."
    },
    {
      "type": "header",
      "content": "Pull Quote"
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote Text",
      "default": "My vision is to create thoughtful, comfortable clothing that lets children move freely, be themselves and have room to be little."
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote Author",
      "default": "Meltem, Founder of Bálá"
    },
    {
      "type": "header",
      "content": "Brand Values"
    },
    {
      "type": "checkbox",
      "id": "show_values",
      "label": "Show Values / Pillars",
      "default": true
    },
    {
      "type": "text",
      "id": "value_1_title",
      "label": "Value 1 Title",
      "default": "Bursa Atelier"
    },
    {
      "type": "text",
      "id": "value_1_desc",
      "label": "Value 1 Description",
      "default": "Crafted closely with skilled artisans in our Bursa atelier."
    },
    {
      "type": "text",
      "id": "value_2_title",
      "label": "Value 2 Title",
      "default": "Pure Fabrics"
    },
    {
      "type": "text",
      "id": "value_2_desc",
      "label": "Value 2 Description",
      "default": "Carefully tested organic textures, fits, and premium finishes."
    },
    {
      "type": "text",
      "id": "value_3_title",
      "label": "Value 3 Title",
      "default": "Room to Be Little"
    },
    {
      "type": "text",
      "id": "value_3_desc",
      "label": "Value 3 Description",
      "default": "Freedom of movement for joyful, everyday childhood adventures."
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "EXPLORE COLLECTIONS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "GET IN TOUCH"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Colors & Layout"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        },
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "background-1",
      "label": "Color Scheme"
    },
    {
      "type": "color",
      "id": "custom_colors_background",
      "default": "#FFFFFF",
      "label": "Custom Background Color"
    },
    {
      "type": "color_background",
      "id": "custom_gradient_background",
      "label": "Custom Gradient Background"
    },
    {
      "type": "color",
      "id": "custom_colors_text",
      "default": "#261D16",
      "label": "Custom Text Color"
    },
    {
      "type": "color",
      "id": "custom_colors_solid_button_background",
      "default": "#1F1E1D",
      "label": "Custom Button Background"
    },
    {
      "type": "color",
      "id": "custom_colors_solid_button_text",
      "default": "#FFFFFF",
      "label": "Custom Button Text"
    },
    {
      "type": "color",
      "id": "custom_colors_outline_button",
      "default": "#1F1E1D",
      "label": "Custom Outline Button"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Section Max Width",
      "default": 1300
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "About Us Story"
    }
  ]
}
{% endschema %}
