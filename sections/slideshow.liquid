  <script>
    (function() {
      function initFadeZoomSlideshow() {
        const container = document.getElementById('Slider-{{ section.id }}');
        if (!container) return;
        const component = container.closest('slideshow-component');
        const slides = Array.from(container.querySelectorAll('.slideshow__slide'));
        if (!slides.length) return;

        let currentIndex = 0;
        const isAutoplay = container.getAttribute('data-autoplay') === 'true';
        const speedSec = parseInt(container.getAttribute('data-speed') || '5', 10);
        let autoTimer = null;

        function stopAutoTimer() {
          if (autoTimer) {
            clearInterval(autoTimer);
            autoTimer = null;
          }
        }

        function startAutoTimer() {
          stopAutoTimer();
          if (!isAutoplay || slides.length <= 1) return;
          autoTimer = setInterval(function() {
            showSlide(currentIndex + 1);
          }, speedSec * 1000);
        }

        function showSlide(index) {
          if (index < 0) index = slides.length - 1;
          if (index >= slides.length) index = 0;
          currentIndex = index;

          slides.forEach((slide, idx) => {
            if (idx === index) {
              slide.classList.add('is-active');
              slide.classList.remove('is-inactive');
            } else {
              slide.classList.remove('is-active');
              slide.classList.add('is-inactive');
            }
          });

          if (component) {
            const dots = component.querySelectorAll('.slider-counter__link');
            dots.forEach((dot, idx) => {
              if (idx === index) {
                dot.classList.add('slider-counter__link--active', 'is-active');
              } else {
                dot.classList.remove('slider-counter__link--active', 'is-active');
              }
            });
          }

          // Reset the timer counter from 0 seconds every time a slide changes
          startAutoTimer();
        }

        // Initialize first slide and start fresh timer
        showSlide(0);

        let startX = 0;
        let startY = 0;
        let isDragging = false;

        container.style.cursor = 'grab';

        function handleStart(e) {
          if (e.target.closest('button, a, .slider-button, .slider-counter__link')) return;
          stopAutoTimer();
          isDragging = true;
          startX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
          startY = e.type.includes('touch') ? e.touches[0].clientY : e.clientY;
          container.style.cursor = 'grabbing';
        }

        function handleEnd(e) {
          if (!isDragging) {
            startAutoTimer();
            return;
          }
          isDragging = false;
          container.style.cursor = 'grab';

          const endX = e.type.includes('touch') ? e.changedTouches[0].clientX : e.clientX;
          const endY = e.type.includes('touch') ? e.changedTouches[0].clientY : e.clientY;
          const diffX = endX - startX;
          const diffY = endY - startY;

          if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 30) {
            if (diffX < 0) {
              showSlide(currentIndex + 1);
            } else {
              showSlide(currentIndex - 1);
            }
          } else {
            startAutoTimer();
          }
        }

        container.addEventListener('mousedown', handleStart);
        container.addEventListener('mouseup', handleEnd);
        container.addEventListener('touchstart', handleStart, { passive: true });
        container.addEventListener('touchend', handleEnd, { passive: true });

        container.addEventListener('mouseenter', stopAutoTimer);
        container.addEventListener('mouseleave', startAutoTimer);

        if (component) {
          const prevBtns = component.querySelectorAll('.slider-button--prev');
          const nextBtns = component.querySelectorAll('.slider-button--next');
          const dots = component.querySelectorAll('.slider-counter__link');

          function enableBtns() {
            prevBtns.forEach(b => { b.removeAttribute('disabled'); b.removeAttribute('aria-disabled'); b.disabled = false; });
            nextBtns.forEach(b => { b.removeAttribute('disabled'); b.removeAttribute('aria-disabled'); b.disabled = false; });
          }
          enableBtns();

          prevBtns.forEach(btn => {
            btn.addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              e.stopImmediatePropagation();
              showSlide(currentIndex - 1);
              enableBtns();
            }, true);
          });

          nextBtns.forEach(btn => {
            btn.addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              e.stopImmediatePropagation();
              showSlide(currentIndex + 1);
              enableBtns();
            }, true);
          });

          dots.forEach((dot, idx) => {
            dot.addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              e.stopImmediatePropagation();
              showSlide(idx);
              enableBtns();
            }, true);
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFadeZoomSlideshow);
      } else {
        initFadeZoomSlideshow();
      }
    })();
  </script>
</slideshow-component>

